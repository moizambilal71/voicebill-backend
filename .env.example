DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Voice feature (get a key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_CHAT_MODEL=gpt-4.1-mini
VOICE_LANGUAGE=ur

# Stock monitor (runs inside runserver). Set STOCK_MONITOR=0 to turn it off.
STOCK_MONITOR=1
STOCK_CHECK_INTERVAL_SECONDS=300

# ---------------------------------------------------------------- Accounts and security
# Long random secret (python -c "import secrets; print(secrets.token_urlsafe(50))"). Required when DJANGO_DEBUG=False.
# DJANGO_SECRET_KEY=

# Emailed verification codes. Default prints the email in the server terminal (fine for testing).
# For real emails use SMTP, e.g. a Gmail "app password" or any mail provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=VoiceBill <you@gmail.com>

# "Continue with Google": OAuth client id (Google Cloud Console > APIs & Services > Credentials > Web client).
# Put the SAME value in the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Free plan size (bills). Payments are not connected yet, so plans are changed by hand:
#   python manage.py set_plan name@example.com pro
FREE_BILL_LIMIT=10
# Turn on only to try the Upgrade screens: it switches an account to Pro for free.
DEMO_UPGRADE=0
PRO_PRICE_LABEL=Price coming soon

# When the site is served over https (ngrok or a real domain): cookies only travel over https.
DJANGO_SECURE_COOKIES=0
# Addresses the site is opened from (add your real domain).
# CSRF_TRUSTED_ORIGINS=https://voicebill.example.com
# Proxies in front of Django that add to X-Forwarded-For (used to rate-limit by visitor address).
TRUSTED_PROXY_COUNT=1
# After an upgrade from the no-accounts version: only this email may take over the old shop data (default: first sign-up).
# LEGACY_SHOP_OWNER_EMAIL=
